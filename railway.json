{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "startCommand": "node --enable-source-maps dist/index.js",
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS",
    "requiredMountPath": "/data"
  }
}
