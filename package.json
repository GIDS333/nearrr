    "@near-js/utils": "^2.5.1",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^12.11.1",
    "bs58": "^6.0.0",
    "dotenv": "^18.0.8",
    "grammy": "^1.46.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
